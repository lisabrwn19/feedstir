rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True if I'm the owner of grocery list `listId`, or a current
    // collaborator on it. Checked live against the list doc, so access
    // reflects current membership without needing anything else kept in sync.
    function isGroceryListMember(listId) {
      return request.auth.uid == listId ||
        request.auth.uid in
          get(/databases/$(database)/documents/groceryLists/$(listId)).data.get('collaboratorIds', []);
    }

    // True if I follow `followedId`. `follows` docs are keyed
    // `{followerId}_{followedId}`, so this is a single-doc existence check
    // rather than a query.
    function isFollowing(followedId) {
      return exists(
        /databases/$(database)/documents/follows/$(request.auth.uid + '_' + followedId)
      );
    }

    // Profile doc (email, display name, photo). Used to resolve grocery-list
    // invites, show a collaborator's email, and show follow-target profiles.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A recipe is readable by its owner, by any current member of a grocery
    // list it's queued onto (queuedOnListId, checked live), or by anyone
    // who follows the owner (an open follow makes someone's whole recipe
    // library visible, not just what they've made). Only the owner can
    // ever write to it.
    match /recipes/{recipeId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        (
          resource.data.get('queuedOnListId', null) != null &&
          isGroceryListMember(resource.data.queuedOnListId)
        ) ||
        isFollowing(resource.data.ownerId)
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Following is open (no approval) — anyone can create a follow doc as
    // themselves, targeting anyone but themselves, and remove their own.
    // Follow relationships aren't sensitive, so any signed-in user can read
    // them (needed for follower/following lists and counts).
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.followerId &&
        request.resource.data.followedId != request.auth.uid &&
        followId == (request.auth.uid + '_' + request.resource.data.followedId);
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.followerId;
    }

    // One grocery list per user, keyed by the owner's uid. Readable/writable
    // by the owner and any accepted collaborator. A non-owner may update the
    // doc ONLY to add themselves to collaboratorIds (accepting an invite) —
    // nothing else.
    match /groceryLists/{listId} {
      // Checks resource.data directly (not the isGroceryListMember() helper)
      // — that helper does an explicit get() on the target list, which is a
      // redundant self-fetch here since this rule IS the list doc being
      // evaluated, and breaks Firestore's query-time rule validation for
      // collection queries (e.g. "which lists do I collaborate on").
      allow read: if request.auth != null && (
        request.auth.uid == listId ||
        request.auth.uid in resource.data.get('collaboratorIds', [])
      );
      allow create: if request.auth != null && request.auth.uid == listId;
      allow update: if request.auth != null && (
        request.auth.uid == listId ||
        (
          request.auth.uid in request.resource.data.get('collaboratorIds', []) &&
          !(request.auth.uid in resource.data.get('collaboratorIds', [])) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaboratorIds']) &&
          request.resource.data.collaboratorIds ==
            resource.data.get('collaboratorIds', []).concat([request.auth.uid])
        )
      );
      allow delete: if request.auth != null && request.auth.uid == listId;

      match /items/{itemId} {
        allow read, write: if request.auth != null && isGroceryListMember(listId);
      }
    }

    // A recipe I've favorited — works for any recipe I can currently read
    // (mine, or a followed user's), not just my own. Docs are keyed
    // `{uid}_{recipeId}` and private to their owner; nobody else needs to
    // see what someone else has favorited.
    match /favorites/{favoriteId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid &&
        favoriteId == (request.auth.uid + '_' + request.resource.data.recipeId);
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // My personal folder tags + rating on a recipe I don't own — works for
    // any recipe I can currently read (mine, or a followed user's). Docs
    // are keyed `{uid}_{recipeId}` and private to their owner. Own recipes
    // use `recipes/{id}.categories`/`.rating` directly instead (I can
    // already write that doc); this exists only for recipes someone else
    // owns.
    match /savedRecipes/{savedRecipeId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.uid &&
        savedRecipeId == (request.auth.uid + '_' + request.resource.data.recipeId);
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['categories', 'rating']);
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Recipes the background aggregator pulled in from recipe-blog RSS
    // feeds for browsing/discovery. Any signed-in user can read the shared
    // pool; only the aggregator (via the Admin SDK, which bypasses these
    // rules entirely) ever writes to it.
    match /discoveredRecipes/{discoveredRecipeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Invites are created by a list owner, addressed to an email. Only the
    // owner or the invited person (matched by verified auth email) can read
    // one. The invited person may only flip `status` (accept/decline).
    match /groceryListInvites/{inviteId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.listOwnerId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.listOwnerId ||
        request.auth.token.email == resource.data.invitedEmail
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.listOwnerId ||
        (
          request.auth.token.email == resource.data.invitedEmail &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        )
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.listOwnerId;
    }
  }
}
