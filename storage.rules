rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Recipe photos, one folder per owner. Photo URLs aren't sensitive on
    // their own (you'd need Firestore read access to a recipe to discover
    // one), so read is open to any signed-in user; only the owner can
    // upload into their own folder.
    match /recipe-photos/{ownerId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == ownerId;
    }
  }
}
